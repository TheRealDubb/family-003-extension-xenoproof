+  have halong : Real.logb Z (comparisonSecond Z s.width X₁ X₂/((∏ P ∈ D₂, P).absNorm : ℝ)) = along := by
+    rw [← hd₂.2.2]
+    exact Real.logb_rpow hbase hZ.ne'
