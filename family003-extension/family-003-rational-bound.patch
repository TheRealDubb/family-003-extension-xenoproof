+    rw [hpw]
+    rw [show HeckeZeroSupremum.beta+sourceShift lxRat ellRat+e-(13/15)*ellMin=
+      (HeckeZeroSupremum.beta+e+sourceShift lxRat ellRat)+(-(13/15:ℝ)*ellMin) by ring,Real.rpow_add hZ0 (HeckeZeroSupremum.beta+e+sourceShift lxRat ellRat) (-(13/15:ℝ)*ellMin)]
+    ring
+  apply hh.trans
+  rw [heq1,heq2]
+  have h1 : C0/e*‖cs⁻¹‖≤C := by
+    dsimp [C]
+    have : 0≤D*c^(-(13/15:ℝ)) := by positivity
+    linarith
+  have h2 : D*c^(-(13/15:ℝ))≤C := by
+    dsimp [C]
+    have : 0≤C0/e*‖cs⁻¹‖ := by positivity
+    linarith
