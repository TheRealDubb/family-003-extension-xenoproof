@@ -0,0 +1,111 @@
+/- Same concrete physical probe as the checked low bound. High bound remains conditional on source moments. -/
+import OAI.NumberTheory.DirichletL.Detector.FinalAssemblyFixedHigh
+import OAI.BelowSevenEighthsTight.AssemblyExtension.FinalAssemblyHigh
+import OAI.BelowSevenEighthsTight.AssemblyExtension.AnalyticBudgets
+import OAI.BelowSevenEighthsTight.RetunedSourceProbe
+import OAI.BelowSevenEighthsTight.MomentExtension.RetunedSourceMomentInput
+
+namespace OAI
+
+noncomputable section
+open scoped Classical BigOperators ContDiff
+open Filter
+namespace SevenEighths.ProbeFinalAssembly
+open _root_.BelowSevenEighthsTight _root_.BelowSevenEighthsTight.Parameters _root_.BelowSevenEighthsTight.PrincipalExtension
+open HeckeFamily ProbePhysical ProbeHighRowFamily Parameters PrincipalSignalComparison
+open HeckeInverseAmplification HeckeDetectorPhysicalSelection HeckeDetectorFiberPartition
+open ProbeMellinBoundary
+
+theorem fixed_high_bound_retuned {recordMesh : ℝ} (hβ : sigmaRat<HeckeZeroSupremum.beta)
+    (D : RetunedHighData (HeckeZeroSupremum.beta-sigmaRat) ellRat (1/1000000000000000) recordMesh) (F : RetunedSourceData D)
+    (counts : _root_.BelowSevenEighthsTight.FiberExtension.RetunedCountParameters F.modulus ⊤ D.t) (τ : ℝ)
+    (hτ : 0<τ) (hτd : τ<(1/200:ℝ)/2) (hτcost : 4*τ<(1/200:ℝ)*D.cost)
+    (hτt : τ<D.t) (hτ2 : 2*τ≤D.t) (hτeps : τ*(2+4*D.eps)<D.t) :
+    ∃C : ℝ,0<C ∧ ∀η : Character,∃Ct : ℝ,0<Ct ∧ ∀ᶠZ : ℝ in atTop,
+      ∀C0 : ℝ,0≤C0 → SourceMomentBound_retuned F counts η Z τ (C0*Z^D.t) (Z^(2*τ)) →
+      ‖F.probe lxRat lyRat η Z-HeckeSignal.signal (η.excludePrimes F.S F.exclusions.prime)
+        (sourceCorrection η F.S) (sourceShift lxRat ellRat) Z‖≤
+        (Ct+C*C0*(η.modulus.absNorm:ℝ)^(2*D.eps))*Z^(HeckeZeroSupremum.beta+sourceShift lxRat ellRat-D.sigma/2) := by
+  let : NeZero (∏P∈F.S,P) := ⟨fixedPrimeProduct_ne_zero F.S F.exclusions.prime⟩
+  have hs := D.sigma_pos
+  have ht := D.t_pos
+  have ht1 := D.t_small
+  have hconductor : hRat+D.t+2*D.t≤7/8 := by norm_num [hRat,ellRat,bRat]; linarith
+  obtain ⟨n,hn,C,hC,hbound⟩ := actual_high_probe_from_raw_moments_retuned F.modulus ⊤ le_top D.N
+    D.e D.eps 1 2 1 D.t (1/200) (7/8) D.rmin τ D.ε D.κ D.cost D.t D.t D.t
+    D.e_pos D.e_small D.eps_pos (by norm_num) (by norm_num) (by norm_num)
+    ht.le (by norm_num) (by norm_num) (by norm_num) D.rmin_pos hτ D.epsilon_pos D.kappa_pos
+    D.cost_pos.le ht D.phase_budget D.epsilon_gap ht (by linarith) hτeps
+    F.S F.exclusions F.first F.maximal D.ell D.slots_injective
+    (fun j=>(D.slots_bounds j).2.1) (fun j=>(D.slots_bounds j).2.2)
