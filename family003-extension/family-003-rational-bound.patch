+  · intro u
+    rcases hbins u with ⟨hi,hin,hgrid,ha0,ha1,hBH,hbuffer,hlo,hhi,hnext,hzero⟩
+    exact ⟨ha0,ha1,hlo,hhi,hnext,hzero⟩
