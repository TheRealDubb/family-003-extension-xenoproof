+  · intro W hW hWu
+    have hcount : 0 ≤ 159*ε+t+t+7*t := by positivity
+    have hw := mul_le_mul_of_nonneg_right hWu hcount
+    linarith only [hw,hεt,het,he8,htm,ht]
