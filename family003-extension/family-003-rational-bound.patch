+theorem actual_deleted_gates_extended {Z Bmask bΦ:ℝ}(s:NaturalState Z Bmask bΦ)
+    (hZ:1<Z)(hB:0≤Bmask)(Mcap L X₁ X₂ ell z κ xi e:ℝ)
+    (hwidth:s.width≤Mcap)(hL:Mcap+Bmask+xi≤L)
+    (hX₁:0<X₁)(hX₂:0<X₂)(hell:0≤ell)(hz:0≤z)(hze:z≤ell)
