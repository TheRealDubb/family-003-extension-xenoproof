+    (hcap : Real.logb Z (X₁*X₂)+ell+(6*κ-1)*ell ≤ M)
+    (D₁ D₂ : Finset (Ideal O)) (hD₁ : ∀ I ∈ D₁, Prime I) (hD₂ : ∀ I ∈ D₂, Prime I)
+    (href : reflected ≤ max 0 (M-Real.logb Z
