+theorem canonical_probe_minus_central_retuned (K : ℕ) (e δ a b B ζ saving : ℝ)
+    (he : 0<e) (he' : e<1/1000) (hδ : 0<δ) (hδ' : δ≤1/2) (hζ : 0<ζ)
+    (ha : 0<a) (hb : 0<b) (hB : 0≤B) (hβ : sigmaRat≤HeckeZeroSupremum.beta)
+    (S : Finset (Ideal O)) (hS : SourceExclusions S) (hmax : ∀P∈S,P.IsMaximal)
+    (hfirst : FirstTail (1/4) S)
+    (W0 W1 : SchwartzMap ℝ ℂ) (a0 b0 a1 b1 : ℝ) (ha0 : 0<a0) (ha1 : 0<a1)
+    (hW0 : Function.support W0⊆Icc a0 b0) (hW1 : Function.support W1⊆Icc a1 b1) :
+    ∃C : ℝ,0<C ∧ ∀(η : Character) (Z : ℝ),1≤Z →
+      ∀(T : Fin K→Finset PrimeIdeal) (_hT : ∀i P,P∈T i→P.val∉S),
+      (∀P:(∀i,T i),Function.Injective (fun i=>(P i).val)) →
+      ∀length : Fin K→ℝ,(∀i,0≤length i) → (∑i,length i)=ellRat →
+      ∀W : Fin K→ℝ→ℂ,(∀i,Function.support (W i)⊆Icc a b) → (∀i y,‖W i y‖≤B) →
+      ‖compensatedPhysicalProbe η (calibrationForSet S hmax) W0 W1
+          (fun i=>canonicalSlotSupport (T i)) W (fun i=>Z^(length i)) (Z^lxRat) (Z^lyRat) Z-
+        principalPhysicalPool η S T W (fun i=>Z^(length i)) W0 W1 (Z^lxRat) (Z^lyRat) Z-
+        finitePhysicalRows S hmax η (rowBand (Z^(1/100:ℝ)) (Z^(hRat+ζ))) T W (fun i=>Z^(length i))
+          W0 W1 (Z^lxRat) (Z^lyRat) Z‖≤
+        C*(η.modulus.absNorm:ℝ)^δ*(Z^(HeckeZeroSupremum.beta+smallTailOffset+8*e)+Z^(-saving)) := by
+  have hheightRat : (1/100:ℝ)≤hRat := by norm_num [hRat,ellRat,bRat]
+  obtain ⟨Cs,hCs,hs⟩ := canonical_small_original_tail_retuned K e δ a b B he he' hδ hδ' ha hb hB hβ
+    S hS hmax hfirst W0 W1 a0 b0 a1 b1 ha0 ha1 hW0 hW1
+  obtain ⟨Cl,hCl,hl⟩ := canonical_large_original_tail_retuned K δ a b B ζ saving hδ (by linarith) hζ ha hb hB
+    S hS hmax hfirst W0 W1 a0 b0 a1 b1 ha0 ha1 hW0 hW1
+  refine ⟨Cs+Cl,add_pos hCs hCl,?_⟩
