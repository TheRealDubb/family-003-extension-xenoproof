+theorem low_remote_gaussian_dyads_retuned (ξ υ total : ℝ)
+    (hscale : ξ+υ=1-total) (htotal1 : total≤1/5) (hxy : ξ≤υ) (hmargin : 0<ξ-total) (S : Finset Id) (hS : ∀P∈S,P.IsMaximal)
+    {K : ℕ} (ell : Fin K→ℝ) (hell : ∀i,0≤ell i) (hsum : ∑i,ell i≤total)
