@@ -0,0 +1,77 @@
+import OAI.BelowSevenEighthsTight.RetunedHighData
+import OAI.BelowSevenEighthsTight.ExtendedGlobalCorrection
+import OAI.NumberTheory.DirichletL.ParametersFixedSource
+import OAI.NumberTheory.DirichletL.Hecke.ModulusRefinement
+
+/- Adapts the original generic finite-source and smooth-window constructors
+   to the retuned parameter record. It does not define or estimate a probe. -/
+set_option autoImplicit false
+namespace BelowSevenEighthsTight.Parameters
+noncomputable section
+open scoped Classical BigOperators ContDiff
+open OAI OAI.SevenEighths
+open HeckeFamily ProbePhysical ProbeHighRowFamily
+local notation "O" => HeckeFamily.O
+
+structure RetunedSourceData {Δ L margin mesh : ℝ}
+    (D : RetunedHighData Δ L margin mesh) where
+  S : Finset (Ideal O)
+  exclusions : SourceExclusions S
+  maximal : ∀ P ∈ S, P.IsMaximal
+  first : FirstTail (4*D.e) S
+  w : ℝ → ℝ
+  W : SchwartzMap ℝ ℂ
+  smooth : ContDiff ℝ ∞ w
+  compact : HasCompactSupport w
+  support : Function.support w ⊆ Set.Ioo 1 2
+  positive_support : tsupport w ⊆ Set.Ioi 0
+  bounded : ∀ x, 0 ≤ w x ∧ w x ≤ 1
+  nonzero : w ≠ 0
+  complex_eq : ∀ x, W x = (w x : ℂ)
+  complex_nonzero : W ≠ 0
+  complex_support : Function.support W ⊆ Set.Icc 1 2
+  real : ∀ x, (W x).im = 0
+  nonnegative : ∀ x, 0 ≤ (W x).re
+
+theorem exists_retuned_source_data {Δ L margin mesh : ℝ}
+    (D : RetunedHighData Δ L margin mesh) : Nonempty (RetunedSourceData D) := by
+  obtain ⟨S,_,hS,hfirst,hmax⟩ :=
+    OAI.SevenEighths.Parameters.exists_fixed_source D.e D.e_pos ∅ (by simp)
+  obtain ⟨w,W,hw,hc,hs,hp,hb,hn,he,hWn,hWs,hr,hWpos⟩ :=
+    OAI.SevenEighths.Parameters.exists_fixed_probe_window
+  exact ⟨⟨S,hS,hmax,hfirst,w,W,hw,hc,hs,hp,hb,hn,he,hWn,hWs,hr,hWpos⟩⟩
+
+def RetunedSourceData.modulus {Δ L margin mesh : ℝ}
+    {D : RetunedHighData Δ L margin mesh} (F : RetunedSourceData D) : Ideal O :=
+  ∏ P ∈ F.S, P
+
+instance {Δ L margin mesh : ℝ} {D : RetunedHighData Δ L margin mesh}
+    (F : RetunedSourceData D) : NeZero F.modulus :=
+  ⟨fixedPrimeProduct_ne_zero F.S F.exclusions.prime⟩
+
+instance {Δ L margin mesh : ℝ} {D : RetunedHighData Δ L margin mesh}
+    (F : RetunedSourceData D) : Finite (O ⧸ F.modulus) :=
+  Ring.HasFiniteQuotients.finiteQuotient (NeZero.ne F.modulus)
+
+theorem retuned_source_analytic {Δ L margin mesh : ℝ}
+    {D : RetunedHighData Δ L margin mesh} (F : RetunedSourceData D)
+    (s₀ : ℝ) (hs₀ : (13/15:ℝ) ≤ s₀) (η : Character) :
+    (∀ I, idealCoeff (η.excludePrimes F.S F.exclusions.prime) I =
+      if IsCoprime I (η.excludePrimes F.S F.exclusions.prime).modulus
+        then idealCoeff η I else 0) ∧
+    AnalyticOnNhd ℂ (fun s=>globalClosedCorrection η F.S s 1 (1/6))
+      {s : ℂ | s₀ < s.re} ∧
+    (∀ s : ℂ, s₀ < s.re → ‖globalClosedCorrection η F.S s 1 (1/6)-1‖ ≤ 1/2) := by
+  refine ⟨excludePrimes_mask η F.S F.exclusions.prime,?_,?_⟩
+  · apply (CorrectionExtension.globalClosedCorrection_analytic_x
+      η F.S F.exclusions.tail 1 (1/6) (by norm_num) (by norm_num)).mono
+    intro s hs
+    exact hs₀.trans_lt hs
+  · intro s hs
+    exact CorrectionExtension.globalClosedCorrection_bound η F.S F.exclusions.tail
+      s 1 (1/6) (hs₀.trans hs.le) (by norm_num) (by norm_num)
+
+#print axioms exists_retuned_source_data
+#print axioms retuned_source_analytic
+end
+end BelowSevenEighthsTight.Parameters
diff --git a/lean/OAI/BelowSevenEighthsTight/RetunedSourceNormalization.lean b/lean/OAI/BelowSevenEighthsTight/RetunedSourceNormalization.lean
new file mode 100644
index 0000000..1300ad9
--- /dev/null
+++ b/lean/OAI/BelowSevenEighthsTight/RetunedSourceNormalization.lean
@@ -0,0 +1,93 @@
+import OAI.NumberTheory.DirichletL.PrincipalSignalComparison
+import OAI.BelowSevenEighthsTight.RationalCertificate
+
+/- Exact normalization of the ORIGINAL source residue integral for arbitrary
+   X=Z^xi and total slot length ell. This does not prove a contour deformation
+   from the physical probe or either asymptotic estimate for that probe. -/
+set_option autoImplicit false
+namespace BelowSevenEighthsTight.PrincipalExtension
+noncomputable section
+open scoped Classical BigOperators Topology
+open MeasureTheory Set Filter Asymptotics Complex
+open OAI OAI.SevenEighths
+open HeckeFamily PrincipalMellinResidues PrincipalSignalComparison
+variable {κ ι : Type*}
+
+def sourceShift (ξ ℓ : ℝ) : ℝ := ξ/3-5/6+ℓ/6
+
+def slotResidue (χ : Character) (H : ℂ→ℂ) (c a Z : ℝ)
+    (S : Finset κ) (T : κ→Finset ι) (w Q : κ→ι→ℝ) (A η : κ→ι→ℂ) : ℂ :=
+  (1/(2*Real.pi) : ℂ) * ∫ t : ℝ,
+    (Z : ℂ)^(((a : ℂ)+t*I)+(c : ℂ)) * Complex.exp ((((a : ℂ)+t*I)-5/6)^2) *
+      H ((a : ℂ)+t*I) / LFunction χ ((a : ℂ)+t*I) *
+        slotRatio S T w Q A η ((a : ℂ)+t*I)
+
+theorem source_power_identity {Z : ℝ} (hZ : 0<Z) (ξ ℓ : ℝ) (s : ℂ) :
+    ((Z^ξ : ℝ) : ℂ)^(1/3 : ℂ) * (Z : ℂ)^(s-5/6) =
+      (Z : ℂ)^(((-ℓ/6 : ℝ) : ℂ)) * (Z : ℂ)^(s+(sourceShift ξ ℓ : ℂ)) := by
+  have hz : (Z : ℂ)≠0 := Complex.ofReal_ne_zero.mpr hZ.ne'
+  rw [←Complex.cpow_mul_ofReal_nonneg hZ.le ξ (1/3),
+    ←Complex.cpow_add _ _ hz,←Complex.cpow_add _ _ hz]
+  congr 1
+  unfold sourceShift
+  push_cast
+  ring_nf
+
+theorem balanced_source_shift (ℓ b : ℝ) :
+    sourceShift ((1-ℓ-b)/2) ℓ = -2/3-b/6 := by
+  unfold sourceShift
+  ring
+
+theorem rational_source_shift : sourceShift lxRat ellRat = -2/3-bRat/6 := by
+  exact balanced_source_shift ellRat bRat
+
+theorem normalized_source_double_residue (W0 W1 : SchwartzMap ℝ ℂ)
+    (M : Ideal HeckeFamily.O) [NeZero M] (χ : Character)
+    (ξ ℓ Y Z : ℝ) (hZ : 0<Z) (s : ℂ) (H B : ℂ→ℂ→ℂ)
+    (S : Finset κ) (T : κ→Finset ι) (w Q : κ→ι→ℝ) (A η : κ→ι→ℂ)
+    (hc : sourceResidueConstant W0 W1 M≠0)
+    (hB : B 1 (1/6)=slotProduct S T w Q A η s) :
+    (fixedPrincipalResidue M^2/6 *
+      sourceMultiplier W0 W1 (Z^ξ) Y Z χ s H B 1 (1/6)) /
+        (sourceResidueConstant W0 W1 M * (Probe.principalScalar S Z ℓ (slotMass T w) : ℂ)) =
+      (Z : ℂ)^(s+(sourceShift ξ ℓ : ℂ)) * Complex.exp ((s-5/6)^2) * H 1 (1/6) /
+        LFunction χ s * slotRatio S T w Q A η s := by
+  rw [source_double_residue,source_normalizer_cast S T w hZ,hB]
+  have hp := source_power_identity hZ ξ ℓ s
+  have hz : (Z : ℂ)^(((-ℓ/6 : ℝ) : ℂ))≠0 :=
+    (Complex.cpow_eq_zero_iff _ _).not.mpr (by simp [hZ.ne'])
+  rw [hp]
+  simp only [slotRatio,div_eq_mul_inv,mul_inv_rev]
+  calc
+    _ = (sourceResidueConstant W0 W1 M * (sourceResidueConstant W0 W1 M)⁻¹) *
+        ((Z : ℂ)^(((-ℓ/6 : ℝ) : ℂ)) * ((Z : ℂ)^(((-ℓ/6 : ℝ) : ℂ)))⁻¹) *
+        ((Z : ℂ)^(s+(sourceShift ξ ℓ : ℂ)) * Complex.exp ((s-5/6)^2) * H 1 (1/6) *
+          (LFunction χ s)⁻¹ * (slotProduct S T w Q A η s *
+            (PrincipalSlotEstimate.principalScalar S (slotMass T w))⁻¹)) := by ring_nf
+    _ = _ := by rw [mul_inv_cancel₀ hc,mul_inv_cancel₀ hz]; ring_nf
+
+theorem sourceResidueIntegral_normalized (W0 W1 : SchwartzMap ℝ ℂ)
+    (M : Ideal HeckeFamily.O) [NeZero M] (χ : Character) (ξ ℓ a Y Z : ℝ) (hZ : 0<Z)
+    (H B : ℂ→ℂ→ℂ→ℂ) (S : Finset κ) (T : κ→Finset ι)
+    (w Q : κ→ι→ℝ) (A η : κ→ι→ℂ)
+    (hc : sourceResidueConstant W0 W1 M≠0)
+    (hm : ∀j∈S,0<slotMass T w j)
+    (hB : ∀t : ℝ,B ((a : ℂ)+t*I) 1 (1/6)=slotProduct S T w Q A η ((a : ℂ)+t*I)) :
+    sourceResidueConstant W0 W1 M * (Probe.principalScalar S Z ℓ (slotMass T w) : ℂ)≠0 ∧
+    sourceResidueIntegral W0 W1 M χ a (Z^ξ) Y Z H B /
+      (sourceResidueConstant W0 W1 M * (Probe.principalScalar S Z ℓ (slotMass T w) : ℂ)) =
+        slotResidue χ (fun s=>H s 1 (1/6)) (sourceShift ξ ℓ) a Z S T w Q A η := by
+  refine ⟨mul_ne_zero hc (source_normalizer_ne_zero S T w hZ hm),?_⟩
+  unfold sourceResidueIntegral ProbePhysical.verticalIntegral slotResidue
+  norm_num only [Complex.ofReal_div,Complex.ofReal_mul,Complex.ofReal_one,Complex.ofReal_ofNat]
+  rw [mul_div_assoc,←integral_div]
+  congr 1
+  apply integral_congr_ae
+  filter_upwards [] with t
