+    exact (tendsto_rpow_atTop (mul_pos (by norm_num) hδ)).eventually (eventually_ge_atTop _)
+  filter_upwards [hc,eventually_gt_atTop (1:ℝ)] with Z hz hZ
+  refine ⟨hZ,?_⟩
+  intro label d hd
+  apply (hz label).trans
+  rw [←Real.rpow_mul (zero_lt_one.trans hZ).le]
