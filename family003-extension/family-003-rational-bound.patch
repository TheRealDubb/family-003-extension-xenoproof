+/- Prepared retuned physical tails. Compilation and replay are recorded separately. -/
+import OAI.BelowSevenEighthsTight.TailExtension.TailScales
+import OAI.NumberTheory.DirichletL.PrimeRows.SmallTail
+import OAI.NumberTheory.DirichletL.PrimeRows.SmallSum
+
+namespace OAI
+
+noncomputable section
+open scoped Classical BigOperators
+open MeasureTheory Set
+namespace SevenEighths.ProbeHighRowFamily
+open _root_.BelowSevenEighthsTight _root_.BelowSevenEighthsTight.PrincipalExtension
+open HeckeFamily HeckeInverseAmplification ProbePhysical ProbeMellinBoundary
+local notation "O" => HeckeFamily.O
+
+theorem small_physical_dyads_sum_retuned (K : ℕ) (e δ a b B : ℝ)
+    (he : 0<e) (he' : e<1/1000) (hδ : 0<δ) (hδ' : δ≤1/2)
+    (ha : 0<a) (hb : 0<b) (hB : 0≤B) (hβ : sigmaRat≤HeckeZeroSupremum.beta)
+    (S : Finset (Ideal O)) (hS : SourceExclusions S) (hmax : ∀P∈S,P.IsMaximal)
+    (hfirst : FirstTail (1/4) S)
+    (W0 W1 : SchwartzMap ℝ ℂ) (a0 b0 a1 b1 : ℝ) (ha0 : 0<a0) (ha1 : 0<a1)
+    (hW0 : Function.support W0⊆Icc a0 b0) (hW1 : Function.support W1⊆Icc a1 b1) :
+    ∃C : ℝ,0<C ∧ ∀(η : Character) (Z : ℝ),1≤Z → ∀F : Finset ℕ,
+      (∀n∈F,(2:ℝ)^n≤Z^(1/100:ℝ)) → ∀R : ℕ→Finset FreeRow,
+      (∀n∈F,∀u∈R n,u.val≠1 ∧ (2:ℝ)^n≤((Ideal.span {u.val}:Ideal O).absNorm:ℝ) ∧
+        ((Ideal.span {u.val}:Ideal O).absNorm:ℝ)≤2*(2:ℝ)^n) →
+      ∀(T : Fin K→Finset PrimeIdeal) (hT : ∀i P,P∈T i→P.val∉S),
+      (∀P:(∀i,T i),Function.Injective (fun i=>(P i).val)) →
+      ∀length : Fin K→ℝ,(∀i,0≤length i) → (∑i,length i)=ellRat →
+      ∀W : Fin K→ℝ→ℂ,(∀i,Function.support (W i)⊆Icc a b) → (∀i y,‖W i y‖≤B) →
+      (∑n∈F,absolutePhysicalDyadIntegral S hS hmax η (R n) T hT W (fun i=>Z^(length i)) W0 W1
+        (Z^lxRat) (Z^lyRat) Z (HeckeZeroSupremum.beta+1/1000+8*e) (1/2) (17/50))
+      ≤C*(η.modulus.absNorm:ℝ)^δ*Z^(HeckeZeroSupremum.beta+smallTailOffset+8*e) := by
+  obtain ⟨C,hC,hmain⟩ := calibrated_physical_dyad_integral K e δ a b (17/50) B
+    (HeckeZeroSupremum.beta+1/1000+8*e) (1/2) he he' hδ (by linarith) ha hb le_rfl hB
+    (rational_tail_sigma_lower _ _ hβ he.le) (by linarith) le_rfl S hS hmax hfirst W0 W1 a0 b0 a1 b1 ha0 ha1 hW0 hW1
+  obtain ⟨D,hD,hsmall⟩ := small_dyadic_square_sum
+  refine ⟨C*D,mul_pos hC hD,?_⟩
+  intro η Z hZ F hF R hR T hT hdis length hl0 hl W hWS hWB
+  have hZ0 : 0<Z := lt_of_lt_of_le zero_lt_one hZ
+  have hYp (i : Fin K) : 1≤Z^(length i) := Real.one_le_rpow hZ (hl0 i)
+  let A : ℝ := C*(η.modulus.absNorm:ℝ)^δ*Z^(HeckeZeroSupremum.beta+smallRawOffset+8*e)
+  have hA : 0≤A := by dsimp [A];positivity
+  have hbnd (n : ℕ) (hn : n∈F) :
+      absolutePhysicalDyadIntegral S hS hmax η (R n) T hT W (fun i=>Z^(length i)) W0 W1
+        (Z^lxRat) (Z^lyRat) Z (HeckeZeroSupremum.beta+1/1000+8*e) (1/2) (17/50)
+      ≤A*((2:ℝ)^n)^(2:ℝ) := by
+    have hUn : 1≤(2:ℝ)^n := one_le_pow₀ (by norm_num)
+    have hh := (hmain η ((2:ℝ)^n) hUn (R n) (hR n hn) T hT hdis (fun i=>Z^(length i)) hYp
+      W hWS hWB (Z^lxRat) (Z^lyRat) Z
+      (Real.rpow_pos_of_pos hZ0 _) (Real.rpow_pos_of_pos hZ0 _) hZ0).2
+    have hpow : ((2:ℝ)^n)^(8/5+δ-(17/50:ℝ))≤((2:ℝ)^n)^(2:ℝ) :=
+      Real.rpow_le_rpow_of_exponent_le hUn (by linarith)
+    have hscale := small_source_scale_retuned Z hZ0 length hl HeckeZeroSupremum.beta e
+    calc
+      _ ≤ (C*(η.modulus.absNorm:ℝ)^δ)*((2:ℝ)^n)^(8/5+δ-(17/50:ℝ))*
+          Z^(HeckeZeroSupremum.beta+smallRawOffset+8*e) := by
+        apply hh.trans_eq
+        rw [←hscale]
+        ring
+      _ ≤ (C*(η.modulus.absNorm:ℝ)^δ)*((2:ℝ)^n)^(2:ℝ)*
+          Z^(HeckeZeroSupremum.beta+smallRawOffset+8*e) := by gcongr
+      _ = _ := by dsimp [A];ring
+  calc
+    _ ≤ ∑n∈F,A*((2:ℝ)^n)^(2:ℝ) := Finset.sum_le_sum hbnd
+    _ = A*∑n∈F,((2:ℝ)^n)^(2:ℝ) := (Finset.mul_sum _ _ _).symm
+    _ ≤ A*(D*(Z^(1/100:ℝ))^(2:ℝ)) := mul_le_mul_of_nonneg_left
+      (hsmall (Z^(1/100:ℝ)) (Real.rpow_pos_of_pos hZ0 _) F hF) hA
+    _ = _ := by
+      dsimp [A]
+      rw [←Real.rpow_mul hZ0.le]
+      have he : Z^(HeckeZeroSupremum.beta+smallRawOffset+8*e)*Z^((1/100:ℝ)*2)=
+          Z^(HeckeZeroSupremum.beta+smallTailOffset+8*e) := by
+        rw [←Real.rpow_add hZ0]
+        congr 1
+        dsimp [smallTailOffset]
+        ring
+      calc
+        _ = (C*D)*(η.modulus.absNorm:ℝ)^δ*
+            (Z^(HeckeZeroSupremum.beta+smallRawOffset+8*e)*Z^((1/100:ℝ)*2)) := by ring
+        _ = _ := by rw [he]
+
+end SevenEighths.ProbeHighRowFamily
+end
+
+end OAI
