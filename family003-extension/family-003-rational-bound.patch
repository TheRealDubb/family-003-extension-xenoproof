+      ∀(T : Fin K→Finset PrimeIdeal) (_hT : ∀i P,P∈T i→P.val∉S),
+      (∀P:(∀i,T i),Function.Injective (fun i=>(P i).val)) →
+      ∀length : Fin K→ℝ,(∀i,0≤length i) → (∑i,length i)=ellRat →
+      ∀W : Fin K→ℝ→ℂ,(∀i,Function.support (W i)⊆Icc a b) → (∀i y,‖W i y‖≤B) →
+      Summable (fun n=>finitePhysicalRows S hmax η (dyadicRows (Z^(hRat+ζ)) n) T W (fun i=>Z^(length i)) W0 W1
+        (Z^lxRat) (Z^lyRat) Z) ∧
+      (∑'n,‖finitePhysicalRows S hmax η (dyadicRows (Z^(hRat+ζ)) n) T W (fun i=>Z^(length i)) W0 W1
+        (Z^lxRat) (Z^lyRat) Z‖)
+      ≤C*(η.modulus.absNorm:ℝ)^δ*Z^(-saving) := by
+  obtain ⟨C,hC,hmain⟩ := large_original_physical_tail_retuned K δ a b B ζ saving hδ hδ' hζ ha hb hB
+    S hS hmax hfirst W0 W1 a0 b0 a1 b1 ha0 ha1 hW0 hW1
+  refine ⟨C,hC,?_⟩
