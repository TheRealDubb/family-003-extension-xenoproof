+theorem principal_physical_pool_ordered_retuned {K : ℕ} (η : Character)
+    (S : Finset Id) (hS : SourceExclusions S)
+    (T : Fin K→Finset PrimeIdeal) (hT : ∀i P,P∈T i→P.val∉S)
+    (hdis : ∀P:(∀i,T i),Function.Injective (fun i=>(P i).val))
