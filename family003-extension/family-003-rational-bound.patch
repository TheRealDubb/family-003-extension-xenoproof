+    (hpole : ¬ (χ = 1 ∧ s = 1)) :
+    _root_.DirichletCharacter.LFunction χ s ≠ 0 := by
+  exact Results.dirichlet_nonvanishing χ s hs hpole
+
+theorem hecke_LFunction_ne_zero_of_rational_lt_re
+    (χ : OAI.SevenEighths.HeckeFamily.Character) (s : ℂ)
