+        principalRowIntegral η S (fun i=>primaryGenerator (P i).val.val) W0 W1 (Z^lxRat) (Z^lyRat) Z := rfl
+  rw [←heq,add_sub_cancel_left]
+  rw [show ∀a b c : ℂ,a+b+c-b=a+c from fun a b c=>by ring]
+  apply (norm_add_le _ _).trans
+  apply (add_le_add hs' ((norm_tsum_le_tsum_norm hl'.1.norm).trans hl'.2)).trans
+  calc
+    _ ≤ (Cs+Cl)*(η.modulus.absNorm:ℝ)^δ*Z^(HeckeZeroSupremum.beta+smallTailOffset+8*e)+
+        (Cs+Cl)*(η.modulus.absNorm:ℝ)^δ*Z^(-saving) := by gcongr <;> linarith
+    _ = _ := by ring
