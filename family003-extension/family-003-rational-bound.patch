+theorem window_analytic_x_retuned {ι : Type*} (η : Character) (S : Finset Id) (hS : CorrectionTail S)
+    (J : Finset ι) (T : ι → Finset PrimeIdeal) (W : ι → ℝ → ℂ) (scale : ι → ℝ)
+    (hT : ∀ j ∈ J, ∀ P ∈ T j, P.val ∉ S) (w z : ℂ)
+    (hw : 9/10 ≤ w.re) (hz : 4/25 ≤ z.re) :
+    AnalyticOnNhd ℂ (fun x => windowMultiplier η J T W scale x w z) {x : ℂ | 13/15 < x.re} :=
