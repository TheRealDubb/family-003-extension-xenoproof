+lemma vertical_triple_eq_joint_retuned (F : ℂ→ℂ→ℂ→ℂ) (a ξ υ : ℝ)
+    (hi : Integrable (fun p : HeightSpace=>F ((a:ℂ)+p.1.1*I) ((υ:ℂ)+p.2*I)
