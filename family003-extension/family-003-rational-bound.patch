+theorem source_batch_plain_marked_fine_retuned {Δ total margin recordMesh : ℝ}{D:_root_.BelowSevenEighthsTight.Parameters.RetunedHighData Δ total margin recordMesh}
+    (S:_root_.BelowSevenEighthsTight.Parameters.RetunedSourceData D)(mesh:ℝ)(hmesh:0<mesh)(hfine:∀j,D.ell j≤mesh/200)
