+theorem compensatedPhysicalProbe_low_retuned (ξ υ total : ℝ) (htotal : 0≤total) (htotal1 : total≤1/5)
+    (hscale : ξ+υ=1-total) (hgap : 0<υ-ξ)
+    (hmargin : 0<2*ξ-υ-total) (hυ : υ≤1) (η : HeckeFamily.Character) (S : Finset Id)
+    (hS : ∀P∈S,P.IsMaximal) (hbad : fixedBadPrimes⊆S)
+    {K : ℕ} (ell : Fin K→ℝ) (hell : ∀i,0≤ell i) (hsum : ∑i,ell i≤total)
