+theorem robust_deleted_reference_window_extended (Z M X₁ X₂ ell z κ ξ e : ℝ)
+    (hZ : 1 < Z) (hM : 0 ≤ M) (hX₁ : 0 < X₁) (hX₂ : 0 < X₂)
