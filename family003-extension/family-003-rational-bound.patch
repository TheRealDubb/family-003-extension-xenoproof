+  have hsave : Z^(-saving)≤E := by dsimp [E];have : 0≤Z^(HeckeZeroSupremum.beta+smallTailOffset+8*e) := Real.rpow_nonneg (by linarith) _;linarith
+  have h0'' : ‖compensatedPhysicalProbe η (calibrationForSet S hmax) W0 W1
