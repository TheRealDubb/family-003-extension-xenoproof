+theorem source_w_shift_retuned {ι : Type*} (η : Character) (S : Finset Id) (hS : SourceExclusions S)
+    (J : Finset ι) (T : ι → Finset PrimeIdeal) (b : ι → PrimeIdeal → ℂ)
