+theorem selected_analytic_x_retuned (η : Character) (S : Finset Id) (hS : CorrectionTail S)
+    (T : Finset PrimeIdeal) (hT : ∀ P ∈ T, P.val ∉ S) (w z : ℂ)
+    (hw : 9/10 ≤ w.re) (hz : 4/25 ≤ z.re) :
+    AnalyticOnNhd ℂ (fun x => selectedMultiplier η T x w z) {x : ℂ | 13/15 < x.re} :=
+  T.analyticOnNhd_fun_prod (fun P hp => local_analytic_x_retuned η S hS P (hT P hp) w z hw hz)
