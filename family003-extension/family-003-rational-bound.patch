+lemma source_scale_identity_retuned {ι : Type*} (J : Finset ι) (ell : ι→ℝ)
+    (hell : ∑j∈J,ell j=ellRat) (Z a ξ υ : ℝ) (hZ : 0<Z) :
+    scalePower (Z^lxRat) (Z^lyRat) Z a ξ υ *
+      (∏j∈J,(Z^(ell j))^ξ) =
+    Z^(a+sourceShift lxRat ellRat+hRat*(ξ-1/6)+lyRat*(υ-1)) := by
+  have hp : (∏j∈J,(Z^(ell j))^ξ)=Z^(ellRat*ξ) := by
+    simp only [←Real.rpow_mul hZ.le]
+    rw [←Real.rpow_sum_of_pos hZ,←Finset.sum_mul,hell]
+  rw [hp,scalePower,←Real.rpow_mul hZ.le,←Real.rpow_mul hZ.le]
+  rw [←Real.rpow_add hZ,←Real.rpow_add hZ,←Real.rpow_add hZ]
+  congr 1
+  dsimp [sourceShift,lxRat,hRat]
+  ring
+
+lemma source_w_scale_identity_retuned {ι : Type*} (J : Finset ι) (ell : ι→ℝ)
+    (hell : ∑j∈J,ell j=ellRat) (Z a e : ℝ) (hZ : 0<Z) :
+    scalePower (Z^lxRat) (Z^lyRat) Z a (1/6+e) (19/20) *
+      (∏j∈J,(Z^(ell j))^(1/6+e)) = Z^(a+sourceShift lxRat ellRat+hRat*e-lyRat/20) := by
+  rw [source_scale_identity_retuned J ell hell Z a (1/6+e) (19/20) hZ]
+  congr 1;ring
+
+lemma source_z_scale_identity_retuned {ι : Type*} (J : Finset ι) (ell : ι→ℝ)
+    (hell : ∑j∈J,ell j=ellRat) (Z a : ℝ) (hZ : 0<Z) :
+    scalePower (Z^lxRat) (Z^lyRat) Z a (33/200) 1 *
+      (∏j∈J,(Z^(ell j))^(33/200:ℝ)) = Z^(a+sourceShift lxRat ellRat-hRat/600) := by
+  rw [source_scale_identity_retuned J ell hell Z a (33/200) 1 hZ]
+  congr 1;ring
+
+lemma eventual_annulus_threshold_retuned {ι : Type*} (η : Character) (J : Finset ι)
+    (c : ℝ) (hc : 0<c) (ell : ι→ℝ) (hell : ∀j∈J,0<ell j) :
+    ∃Z0 : ℝ,1≤Z0 ∧ ∀Z : ℝ,Z0≤Z→∀j∈J,
+      480≤c*Z^(ell j) ∧ (Ideal.absNorm η.modulus:ℝ)<c*Z^(ell j) := by
+  have hh : ∀ᶠZ : ℝ in atTop,∀j∈J,
+      480≤c*Z^(ell j) ∧ (Ideal.absNorm η.modulus:ℝ)<c*Z^(ell j) := by
+    apply (Filter.eventually_all_finset J).mpr
+    intro j hj
+    have ht := (tendsto_rpow_atTop (hell j hj)).const_mul_atTop hc
+    exact (ht.eventually (eventually_ge_atTop 480)).and
+      (ht.eventually (eventually_gt_atTop (Ideal.absNorm η.modulus:ℝ)))
+  obtain ⟨Z0,hZ0⟩ := eventually_atTop.mp hh
+  refine ⟨max 1 Z0,le_max_left _ _,?_⟩
+  intro Z hZ
+  exact hZ0 Z ((le_max_right _ _).trans hZ)
+
+theorem source_remainders_power_bound_retuned {ι : Type*}
+    (η : Character) (S : Finset Id) (hS : SourceExclusions S)
+    (J : Finset ι) (c d B : ℝ) (hc : 0<c) (hd : c≤d) (hB : 0≤B)
+    (W0 W1 : SchwartzMap ℝ ℂ) (a0 b0 a1 b1 : ℝ) (ha0 : 0<a0) (ha1 : 0<a1)
+    (hW0 : Function.support W0⊆Icc a0 b0) (hW1 : Function.support W1⊆Icc a1 b1)
+    (a e : ℝ) (ha : a∈Icc (13/15:ℝ) 2) (hβ : HeckeZeroSupremum.beta<a)
+    (he : 0<e) (hehi : e≤5/6) :
+    ∃C : ℝ,0<C ∧ ∀(ell : ι→ℝ),(∑j∈J,ell j=ellRat) → ∀(W : ι→ℝ→ℝ),
+    (∀j∈J,∀x,0≤W j x ∧ W j x≤B) →
+    (∀j∈J,Function.support (W j)⊆Icc c d) → ∀T : ι→Finset PrimeIdeal,
+    (∀j∈J,∀p∈T j,p.val∉S) → ∀Z : ℝ,0<Z→
+    (∀j∈J,480≤c*Z^(ell j)) → (∀j∈J,(Ideal.absNorm η.modulus:ℝ)<c*Z^(ell j)) →
+    let K0 := fun s=>sourceMultiplier W0 W1 (Z^lxRat) (Z^lyRat) Z
+      (η.excludePrimes S hS.prime) s (globalClosedCorrection η S s)
+      (windowMultiplier η J T (fun j x=>(W j x:ℂ)) (fun j=>Z^(ell j)) s)
+    let π := fixedSourcePrincipal S hS.prime
+    (‖verticalIntegral a (fun s=>verticalIntegral (1/6+e) (fun z=>verticalIntegral (19/20)
+      (fun w=>K0 s w z*LFunction π (6*z)*LFunction π w)))‖≤
+      C/e*Z^(a+sourceShift lxRat ellRat+hRat*e-lyRat/20)) ∧
+    (‖HeckeReciprocal.regularizedL π 1 * verticalIntegral a (fun s=>verticalIntegral (33/200)
+      (fun z=>K0 s 1 z*LFunction π (6*z)))‖≤C*Z^(a+sourceShift lxRat ellRat-hRat/600)) := by
+  obtain ⟨C,hC,hbound⟩ := ordered_remainders_scale_bound_retuned η S hS J c d B hc hd hB
+    W0 W1 a0 b0 a1 b1 ha0 ha1 hW0 hW1 a e ha hβ he hehi
+  refine ⟨C,hC,?_⟩
+  intro ell hell W hW hsupp T hT Z hZ hthreshold hmod
+  dsimp only
+  have hh := hbound W hW hsupp (fun j=>Z^(ell j)) (fun _ _=>Real.rpow_pos_of_pos hZ _)
+    hthreshold hmod T hT (Z^lxRat) (Z^lyRat) Z
+    (Real.rpow_pos_of_pos hZ _) (Real.rpow_pos_of_pos hZ _) hZ
+  dsimp only at hh
+  rw [source_w_scale_identity_retuned J ell hell Z a e hZ,source_z_scale_identity_retuned J ell hell Z a hZ] at hh
+  exact hh
