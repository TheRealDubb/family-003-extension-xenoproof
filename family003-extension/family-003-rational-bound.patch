+theorem combined_slot_analytic_x_retuned {ι : Type*} (η : Character) (S : Finset Id) (hS : CorrectionTail S)
+    (J : Finset ι) (T : ι → Finset PrimeIdeal) (b : ι → PrimeIdeal → ℂ)
+    (hT : ∀ j ∈ J, ∀ P ∈ T j, P.val ∉ S) (w z : ℂ)
+    (hw : 9/10 ≤ w.re) (hz : 4/25 ≤ z.re) :
+    AnalyticOnNhd ℂ (fun x => globalClosedCorrection η S x w z * slotMultiplier η J T b x w z)
+      {x : ℂ | 13/15 < x.re} :=
+  (_root_.BelowSevenEighthsTight.CorrectionExtension.globalClosedCorrection_analytic_x η S hS w z hw hz).mul
+    (slot_analytic_x_retuned η S hS J T b hT w z hw hz)
