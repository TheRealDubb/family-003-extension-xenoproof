+def sourceFixedIdeal_retuned (F : _root_.BelowSevenEighthsTight.Parameters.RetunedSourceData D) : Ideal O :=
+  F.modulus⊓Ideal.span {(72:O)}
+
+lemma sourceFixedIdeal_ne_zero_retuned (F : _root_.BelowSevenEighthsTight.Parameters.RetunedSourceData D) : sourceFixedIdeal_retuned F≠0 :=
+  Ideal.inf_ne_bot_of_ne_bot (NeZero.ne F.modulus)
+    (Ideal.span_singleton_eq_bot.not.mpr (by norm_num : (72:O)≠0))
+
+lemma sourceFixedIdeal_ne_top_retuned (F : _root_.BelowSevenEighthsTight.Parameters.RetunedSourceData D) : sourceFixedIdeal_retuned F≠⊤ := by
+  have hmem : Ideal.span {goodLambda}∈F.S := by
+    apply F.exclusions.bad
+    change Ideal.span {goodLambda}∈({Ideal.span {goodLambda},Ideal.span {(2:O)}} : Finset (Ideal O))
+    simp
+  have hle : F.modulus≤Ideal.span {goodLambda} := by
+    apply Ideal.dvd_iff_le.mp
+    exact Finset.dvd_prod_of_mem (fun P : Ideal O=>P) hmem
+  have hprime := (F.maximal _ hmem).isPrime
+  intro h
+  exact hprime.ne_top (top_le_iff.mp (h ▸ (inf_le_left.trans hle : sourceFixedIdeal_retuned F≤Ideal.span {goodLambda})))
+
+lemma sourceFixedIdeal_le_modulus_retuned (F : _root_.BelowSevenEighthsTight.Parameters.RetunedSourceData D) : sourceFixedIdeal_retuned F≤F.modulus := inf_le_left
+lemma sourceFixedIdeal_le_72_retuned (F : _root_.BelowSevenEighthsTight.Parameters.RetunedSourceData D) : sourceFixedIdeal_retuned F≤Ideal.span {(72:O)} := inf_le_right
+
+def sourceExceptional_retuned (F : _root_.BelowSevenEighthsTight.Parameters.RetunedSourceData D) (η : Character) (u : FreeRow) : Prop :=
+  FixedInducingRow η (internalQ (sourceFixedIdeal_retuned F) η)
+    (fixedBadMask*idealGenerator 1) 1 u.val
+
+theorem source_retained_sector_nonprincipal_retuned (F : _root_.BelowSevenEighthsTight.Parameters.RetunedSourceData D)
+    (η : Character) (u : FreeRow) (hu : ¬sourceExceptional_retuned F η u)
+    (θ : RayQuotient.Characters F.modulus ⊤) :
+    ((naturalRow η u.val u.property.1).character.product
+      (relativeCharacter F.modulus ⊤ le_top η θ)).residue≠1 :=
+  internal_sector_nonprincipal F.modulus ⊤ le_top (naturalRow η u.val u.property.1)
+    η θ (sourceFixedIdeal_retuned F) 1 (sourceFixedIdeal_le_modulus_retuned F) one_ne_zero u.property.1 hu
+
+theorem source_energy_split_retuned (F : _root_.BelowSevenEighthsTight.Parameters.RetunedSourceData D) (η : Character)
+    (rows : Finset FreeRow) (f : FreeRow→ℂ) :
+    (∑u∈rows,‖f u‖^2)=
+      (∑u∈rows.filter (fun u=>¬sourceExceptional_retuned F η u),‖f u‖^2)+
+      ∑u∈rows.filter (sourceExceptional_retuned F η),‖f u‖^2 := by
+  simpa only [not_not] using
+    (Finset.sum_filter_add_sum_filter_not rows (fun u=>¬sourceExceptional_retuned F η u)
+      (fun u=>‖f u‖^2)).symm
+
